<resources>
    <style name="Theme.PulseWave" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/obsidian_bg</item>
    </style>

    <style name="Theme.PulseWave.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/obsidian_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PulseWave</item>
    </style>
</resources>
